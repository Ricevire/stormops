[Unit]
Description=StormOps 媒体基建运维平台
Documentation=https://github.com/Ricevire/stormops
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/stormops/bin/stormops -config /etc/stormops/config.json
Restart=always
RestartSec=3
StandardOutput=append:/var/log/stormops/stormops.log
StandardError=append:/var/log/stormops/stormops.log

# 2C2G 的机器上必须给每个进程设上限，否则一次内存泄漏就能把整机拖进 OOM。
MemoryMax=320M
MemoryHigh=256M
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
